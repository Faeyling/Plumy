# ElevenLabs TTS (optionnel — fallback sur Web Speech API si absent)
# Crée un compte sur https://elevenlabs.io, copie ta clé API dans .env.local
VITE_ELEVENLABS_API_KEY=
# ID de voix ElevenLabs (défaut : Elli — enjouée, compatible multilingual v2)
# Liste des voix : https://elevenlabs.io/voice-library
VITE_ELEVENLABS_VOICE_ID=MF3mGyEYCl7XYWbV9V6O
